NODE_ENV=development
DATABASE_PROVIDER=pglite
PGLITE_DATA_DIR=../../packages/db/.data/pglite
PGLITE_AUTO_MIGRATE=false
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_SESSION_PASSWORD=REPLACE_WITH_32_CHARACTER_SESSION_SECRET
# Set true only when the app is behind a trusted reverse proxy that overwrites X-Forwarded-For.
NUXT_TRUST_PROXY=false
S3_ENDPOINT=file://./.data/documents
S3_REGION=local
S3_BUCKET=book-moto-private
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Transactional outbox / Telegram delivery.
# Leave the Telegram values empty to keep events pending instead of failing them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE_URL=https://api.telegram.org
OUTBOX_WORKER_SECRET=REPLACE_WITH_WORKER_SECRET
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=60000
OUTBOX_WORKER_INTERVAL_MS=15000

# Recovery drill (see docs/runbooks/backup-restore.md).
RECOVERY_ROOT=.data/recovery
RECOVERY_SOURCE_ENV=development
RECOVERY_RPO_HOURS=24
# A restore is refused unless this marker is exactly "isolated".
# RECOVERY_TARGET_ENV=isolated
# RECOVERY_TARGET_PGLITE_DIR=.data/recovery/target/pglite
# RECOVERY_TARGET_STORAGE_ROOT=.data/recovery/target/documents
# RECOVERY_TARGET_DATABASE_URL=
# RECOVERY_TARGET_S3_ENDPOINT=
# RECOVERY_TARGET_S3_REGION=
# RECOVERY_TARGET_S3_BUCKET=
# RECOVERY_TARGET_S3_ACCESS_KEY_ID=
# RECOVERY_TARGET_S3_SECRET_ACCESS_KEY=
# Comma-separated target fingerprints that must never be restored into.
# RECOVERY_PRODUCTION_FINGERPRINT=
# RECOVERY_PRODUCTION_DATABASE_URL=
