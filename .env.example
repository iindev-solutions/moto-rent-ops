NODE_ENV=development
DATABASE_PROVIDER=pglite
PGLITE_DATA_DIR=../../packages/db/.data/pglite
PGLITE_AUTO_MIGRATE=false
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_SESSION_PASSWORD=REPLACE_WITH_32_CHARACTER_SESSION_SECRET
S3_ENDPOINT=file://./.data/documents
S3_REGION=local
S3_BUCKET=book-moto-private
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
